{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "crons": [
    {
      "path": "/api/crm-scheduled-send",
      "schedule": "0 8 * * *"
    }
  ],
  "redirects": [{ "source": "/demos/stradivari-cable", "destination": "/demos/stradivari-cable/", "permanent": true }],
  "rewrites": [
    { "source": "/.well-known/oauth-authorization-server/crm-email-identity", "destination": "/api/crm-email-oauth?action=metadata" },
    { "source": "/.well-known/oauth-protected-resource/api/crm-email-live-mcp", "destination": "/api/crm-email-oauth?action=resource" },
    {"source": "/demos/stradivari-cable/assets/overview.bin", "destination": "https://assets.iobjectm.com/iom-website/v1/44f8ffff445a439a931bc11a5ccd254947f3ea08c832bc8a877085d9b8b48f14/overview.glb.gz"},
    {"source": "/demos/stradivari-cable/assets/detail-1.bin", "destination": "https://assets.iobjectm.com/iom-website/v1/fd50cb30d04a5dea74acf3840a696985316558e1a1e82f173eeeb98d85ae233d/detail-1.glb.gz"},
    {"source": "/demos/stradivari-cable/assets/detail-2.bin", "destination": "https://assets.iobjectm.com/iom-website/v1/3182972ccd29532a5b851f700e3ff87e164bb7dee1be3bd85149308b3dd13a75/detail-2.glb.gz"},
    {"source": "/demos/stradivari-cable/assets/detail-3.bin", "destination": "https://assets.iobjectm.com/iom-website/v1/3a763fa8f5d056036838f510b49a5932eeb1e4393485dc75983a80a202b9ce75/detail-3.glb.gz"},
    {"source": "/demos/stradivari-cable/assets/detail-4.bin", "destination": "https://assets.iobjectm.com/iom-website/v1/6182ec208da24a9fdd27b22fe3e5ac1cc5b603ccd6738a090e8fe23821f88cb7/detail-4.glb.gz"},
    {"source": "/demos/stradivari-cable/assets/metro-vijzelgracht.hdr", "destination": "https://assets.iobjectm.com/iom-website/v1/41dc861f3ae18a9961d3d5a3b48429b1ac2832e5862ad25f8e95c43d3296fb7b/metro-vijzelgracht.hdr"},
    { "source": "/demos/stradivari-cable/", "destination": "/demos/stradivari-cable/index.html" },
    { "source": "/demos/dukta-linar-architecture", "destination": "/demos/dukta-linar-architecture/index.html" },
    { "source": "/demos/dukta-linar-architecture/", "destination": "/demos/dukta-linar-architecture/index.html" },
    {
      "source": "/demos/lobo-mobo-study",
      "destination": "/demos/lobo-mobo-study/index.html"
    },
    {
      "source": "/demos/lobo-mobo-study/",
      "destination": "/demos/lobo-mobo-study/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/demo/evly",
      "destination": "/demo/evly/index.html"
    },
    {
      "source": "/demo/evly/",
      "destination": "/demo/evly/index.html"
    },
    {
      "source": "/demos/dukta",
      "destination": "/demos/dukta/index.html"
    },
    {
      "source": "/demos/dukta/",
      "destination": "/demos/dukta/index.html"
    },
    {
      "source": "/demos/dukta/projects",
      "destination": "/demos/dukta/index.html"
    },
    {
      "source": "/demos/dukta/projects/",
      "destination": "/demos/dukta/index.html"
    },
    {
      "source": "/demos/dukta/material",
      "destination": "/demos/dukta/index.html"
    },
    {
      "source": "/demos/dukta/material/",
      "destination": "/demos/dukta/index.html"
    },
    {
      "source": "/demos/dukta/systems/:path*",
      "destination": "/demos/dukta/index.html"
    },
    {
      "source": "/demos/dukta/resources",
      "destination": "/demos/dukta/index.html"
    },
    {
      "source": "/demos/dukta/resources/",
      "destination": "/demos/dukta/index.html"
    },
    {
      "source": "/demos/dukta/configure/:path*",
      "destination": "/demos/dukta/index.html"
    },
    {
      "source": "/blog/gallery-of-light-sculpture-sound",
      "destination": "/blog/gallery-of-light-sculpture-sound/index.html"
    },
    {
      "source": "/blog/gallery-of-light-sculpture-sound/",
      "destination": "/blog/gallery-of-light-sculpture-sound/index.html"
    },
    {
      "source": "/:lang(de|fr|nl|it|es)/blog/gallery-of-light-sculpture-sound",
      "destination": "/:lang/blog/gallery-of-light-sculpture-sound/index.html"
    },
    {
      "source": "/:lang(de|fr|nl|it|es)/blog/gallery-of-light-sculpture-sound/",
      "destination": "/:lang/blog/gallery-of-light-sculpture-sound/index.html"
    },
    {
      "source": "/demos/gallery-of-light",
      "destination": "/demos/gallery-of-light/index.html"
    },
    {
      "source": "/demos/gallery-of-light/",
      "destination": "/demos/gallery-of-light/index.html"
    },
    {
      "source": "/blog/robot-cell-browser-palletizing",
      "destination": "/blog/robot-cell-browser-palletizing/index.html"
    },
    {
      "source": "/blog/robot-cell-browser-palletizing/",
      "destination": "/blog/robot-cell-browser-palletizing/index.html"
    },
    {
      "source": "/:lang(de|fr|nl|it|es)/blog/robot-cell-browser-palletizing",
      "destination": "/:lang/blog/robot-cell-browser-palletizing/index.html"
    },
    {
      "source": "/:lang(de|fr|nl|it|es)/blog/robot-cell-browser-palletizing/",
      "destination": "/:lang/blog/robot-cell-browser-palletizing/index.html"
    },
    {
      "source": "/blog/solar-system-living-observatory",
      "destination": "/blog/solar-system-living-observatory/index.html"
    },
    {
      "source": "/blog/solar-system-living-observatory/",
      "destination": "/blog/solar-system-living-observatory/index.html"
    },
    {
      "source": "/:lang(de|fr|nl|it|es)/blog/solar-system-living-observatory",
      "destination": "/:lang/blog/solar-system-living-observatory/index.html"
    },
    {
      "source": "/:lang(de|fr|nl|it|es)/blog/solar-system-living-observatory/",
      "destination": "/:lang/blog/solar-system-living-observatory/index.html"
    },
    {
      "source": "/((?!(?:de|fr|nl|it|es)/blog/gallery-of-light-sculpture-sound(?:/|$)|blog/gallery-of-light-sculpture-sound(?:/|$)|assets/|demos/|demo/evly/|api/|fonts/|models/|env/|textures/|(?:de|fr|nl|es|it)/project-costs|project-costs|(?:de|fr|nl|it|es)/blog/solar-system-living-observatory(?:/|$)|blog/solar-system-living-observatory(?:/|$)|(?:de|fr|nl|it|es)/blog/robot-cell-browser-palletizing(?:/|$)|blog/robot-cell-browser-palletizing(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    { "source": "/demos/stradivari-cable(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] },
    {
      "source": "/demos/dukta-linar-architecture(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://api.web3forms.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://vercel.live https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://cdn.jsdelivr.net https://fonts.gstatic.com; media-src 'self' blob: https:; worker-src 'self' blob: https://cdn.jsdelivr.net; connect-src 'self' https: wss: blob:; frame-src 'self' https://vercel.live https://3dbviewer.com https://streets.gl https://www.procedural.eu https://www.youtube.com https://www.youtube-nocookie.com"
        }
      ]
    },
    {
      "source": "/demo/evly/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/demos/dukta/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/demos/icm-building/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/client-login",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/crm-demo",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/raven_crop.mp4",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        }
      ]
    },
    {
      "source": "/demos/lobo-mobo-study(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
