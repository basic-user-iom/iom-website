{
  "name": "iom-building-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "IOM Professional Web 3D Building Viewer",
  "scripts": {
    "dev": "vite",
    "build": "npm run model:validate && npm run model:collision-coverage:all && npm run test:character-stairs && npm run test:dual-layer-grounding && npm run test:stair-geometry && npm run test:visual-correctness && npm run test:surface-visibility && npm run test:lighting-calibration && npm run test:runtime-stability && npm run test:performance-monitor && npm run test:instancing-runtime-prereqs && npm run test:hlod-contract && npm run test:hlod-runtime && npm run test:disabled-manifest-v3-candidate && npm run test:stream-recovery && npm run test:verified-glb && npm run test:collision-activation && npm run test:shared-texture-residency && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:performance-monitor": "node scripts/test-performance-monitor.mjs",
    "test:runtime-stability": "node scripts/test-runtime-stability.mjs",
    "test:character-stairs": "node scripts/test-character-controller-stairs.mjs",
    "test:dual-layer-grounding": "node scripts/test-dual-layer-grounding.mjs",
    "test:stair-geometry": "node scripts/test-stair-geometry.mjs",
    "test:visual-correctness": "node scripts/test-visual-correctness.mjs",
    "test:surface-visibility": "node scripts/test-surface-visibility.mjs",
    "test:lighting-calibration": "node scripts/test-lighting-calibration.mjs",
    "test:instancing-runtime-prereqs": "node scripts/test-instancing-runtime-prereqs.mjs",
    "test:hlod-contract": "node scripts/test-animation-package-manifest-v3.mjs",
    "test:hlod-runtime": "node scripts/test-animation-package-runtime.mjs",
    "test:disabled-manifest-v3-candidate": "node scripts/test-disabled-manifest-v3-candidate.mjs",
    "test:collision-activation": "node scripts/test-collision-activation-contract.mjs && npm run model:collision-evidence:check",
    "test:stream-recovery": "node scripts/test-stream-focus-failover-hardening.mjs",
    "test:shared-texture-residency": "node scripts/test-shared-texture-residency.mjs",
    "qa:shared-texture-candidate": "node scripts/qa-shared-texture-release-candidate.mjs",
    "qa:unowned-static-shared-textures": "node scripts/qa-unowned-static-shared-texture-candidate.mjs",
    "qa:local-performance": "node scripts/qa-local-performance-baseline.mjs",
    "test:stream-payload-offline": "node scripts/test-stream-payload-offline-gate.mjs",
    "test:verified-glb": "node scripts/test-verified-glb-boundary.mjs",
    "qa:surface-visibility": "node scripts/qa-surface-visibility.mjs",
    "qa:auditorium-navigation": "node scripts/qa-auditorium-navigation.mjs",
    "qa:dual-layer-grounding": "node scripts/qa-dual-layer-grounding.mjs",
    "qa:lighting-calibration": "node scripts/qa-lighting-calibration.mjs",
    "model:validate": "node scripts/validate-model-assets.mjs",
    "model:gate": "node scripts/validate-model-assets.mjs --require-current-reports --enforce-budgets --fail-on-warn",
    "model:collision-coverage": "node scripts/validate-collision-coverage.mjs",
    "model:collision-coverage:all": "node scripts/validate-collision-coverage.mjs --id icm-ext && node scripts/validate-collision-coverage.mjs --id icm-anim-2025",
    "model:collision-evidence:generate": "node scripts/generate-collision-activation-evidence.mjs --id icm-anim-2025 --write",
    "model:collision-evidence:check": "node scripts/generate-collision-activation-evidence.mjs --id icm-anim-2025 && node scripts/validate-collision-activation-contract.mjs --contract ../public/models/icm-anim-2025/collision-activation-v1.json --coverage ../public/models/icm-anim-2025/collision-coverage-v1.json --collision ../public/models/icm-anim-2025/collision.glb",
    "model:collision-evidence:inspect": "node scripts/generate-collision-activation-evidence.mjs --id icm-anim-2025 --inspect",
    "model:optimize": "node scripts/optimize-building-model.mjs",
    "model:gltfpack": "node scripts/run-gltfpack.mjs",
    "model:normalize-scenes": "node scripts/normalize-model-scenes.mjs",
    "model:batch": "node scripts/offline-batch-model.mjs",
    "tool:gltfpack:check": "node scripts/run-gltfpack.mjs --check",
    "model:cells": "node scripts/bake-cell-manifest.mjs",
    "model:collision": "node scripts/extract-collision-glb.mjs",
    "model:scan-instancing": "node scripts/scan-instancing.mjs",
    "model:analyze-animation-owners": "node scripts/analyze-animation-owner-workload.mjs",
    "model:scan-materials": "node scripts/scan-materials.mjs",
    "model:audit-surfaces": "node scripts/audit-surface-visibility.mjs",
    "model:extract-golden": "node scripts/extract-golden-slice.mjs",
    "model:build-golden": "node scripts/build-golden-slice.mjs",
    "model:plan-first-floor-pilot": "node scripts/build-first-floor-package-pilot.mjs --plan-only",
    "model:build-first-floor-pilot": "node scripts/build-first-floor-package-pilot.mjs",
    "model:build-first-floor-coalesced-pilot": "node scripts/build-first-floor-package-pilot.mjs --partition material-aware",
    "model:audit-first-floor-coalesced-pilot": "node scripts/audit-first-floor-package-pilot.mjs tmp/hlod-pilot-first-floor-coalesced/detail-package-index.json",
    "model:build-first-floor-shell-candidate": "node scripts/build-first-floor-package-pilot.mjs --shell-candidate",
    "model:audit-first-floor-shell-candidate": "node scripts/audit-first-floor-package-pilot.mjs tmp/hlod-pilot-first-floor-shell-candidate/detail-package-index.json --require-shell",
    "model:build-second-floor-shell-candidate": "node scripts/build-first-floor-package-pilot.mjs --profile second-floor --shell-candidate",
    "model:audit-second-floor-shell-candidate": "node scripts/audit-first-floor-package-pilot.mjs tmp/hlod-pilot-second-floor-shell-candidate/detail-package-index.json --profile second-floor --require-shell",
    "model:build-mezzanine-shell-candidate": "node scripts/build-first-floor-package-pilot.mjs --profile mezzanine --shell-candidate",
    "model:audit-mezzanine-shell-candidate": "node scripts/audit-first-floor-package-pilot.mjs tmp/hlod-pilot-mezzanine-shell-candidate/detail-package-index.json --profile mezzanine --require-shell",
    "model:build-ceiling-shell-candidate": "node scripts/build-first-floor-package-pilot.mjs --profile ceiling --shell-candidate",
    "model:audit-ceiling-shell-candidate": "node scripts/audit-first-floor-package-pilot.mjs tmp/hlod-pilot-ceiling-shell-candidate/detail-package-index.json --profile ceiling --require-shell",
    "model:ground-floor-owner-migration:generate": "node scripts/build-ground-floor-source-ownership-migration.mjs --write --check",
    "model:ground-floor-owner-migration:check": "node scripts/build-ground-floor-source-ownership-migration.mjs --check",
    "model:build-ground-floor-shell-candidate": "npm run model:ground-floor-owner-migration:generate && node scripts/build-first-floor-package-pilot.mjs --profile ground-floor --shell-candidate --force",
    "model:audit-ground-floor-shell-candidate": "npm run model:ground-floor-owner-migration:check && node scripts/audit-first-floor-package-pilot.mjs tmp/hlod-pilot-ground-floor-shell-candidate/detail-package-index.json --profile ground-floor --require-shell",
    "model:prepare-first-floor-shell-visual-qa": "node scripts/prepare-first-floor-shell-visual-qa.mjs",
    "model:audit-first-floor-shell-visual-qa": "node scripts/audit-first-floor-shell-visual-qa.mjs",
    "model:prepare-disabled-manifest-v3-request": "node scripts/prepare-disabled-manifest-v3-request.mjs",
    "model:review-disabled-manifest-v3-candidate": "node scripts/review-disabled-manifest-v3-candidate.mjs",
    "model:emit-disabled-manifest-v3-candidate": "node scripts/emit-disabled-manifest-v3-candidate.mjs",
    "model:analyze-shared-texture-residency-pilot": "node scripts/analyze-shared-texture-residency-pilot.mjs",
    "model:build-shared-texture-candidate": "node scripts/build-shared-texture-release-candidate.mjs",
    "model:build-repeat-lod-pilot": "node scripts/build-ground-floor-selective-repeat-lod-pilot.mjs",
    "model:audit-repeat-lod-renders": "node scripts/audit-repeat-lod-render-comparison.mjs",
    "model:build-repeat-release-candidate": "node scripts/build-ground-floor-repeat-instancing-pilot.mjs && node scripts/build-ground-floor-selective-repeat-lod-pilot.mjs && node scripts/build-ground-floor-repeat-release-candidate.mjs",
    "qa:repeat-release-candidate": "node scripts/qa-ground-floor-repeat-release-candidate.mjs",
    "test:repeat-release-candidate": "npm run model:build-repeat-release-candidate && npm run test:instancing-runtime-prereqs && npm run qa:repeat-release-candidate",
    "model:build-repeat-spatial-v2": "node scripts/build-ground-floor-repeat-spatial-payload-v2.mjs",
    "audit:repeat-spatial-v2": "node scripts/test-ground-floor-repeat-spatial-payload-v2.mjs",
    "test:repeat-spatial-v2:determinism": "node scripts/verify-ground-floor-repeat-spatial-v2-determinism.mjs",
    "test:repeat-spatial-v2": "npm run model:build-repeat-spatial-v2 && npm run audit:repeat-spatial-v2 && npm run test:repeat-spatial-v2:determinism && npm run audit:repeat-spatial-v2",
    "model:analyze-repeat-reservation-what-if": "node scripts/analyze-repeat-spatial-reservation-what-if.mjs",
    "model:build-fire-hose-ownership-candidate": "node scripts/build-ground-floor-fire-hose-ownership-candidate.mjs",
    "test:fire-hose-ownership-candidate": "npm run model:build-fire-hose-ownership-candidate && node scripts/test-ground-floor-fire-hose-ownership-candidate.mjs",
    "model:generate-whole-layer-ownership": "node scripts/generate-whole-layer-ownership-coverage.mjs",
    "test:whole-layer-ownership": "node scripts/test-whole-layer-ownership-coverage.mjs",
    "model:compose-whole-layer-owner-claims": "node scripts/compose-whole-layer-owner-claims.mjs --candidate tmp/hlod-pilot-first-floor-shell-candidate/detail-package-index.json --candidate tmp/hlod-pilot-second-floor-shell-candidate/detail-package-index.json --candidate tmp/hlod-pilot-mezzanine-shell-candidate/detail-package-index.json --candidate tmp/hlod-pilot-ceiling-shell-candidate/detail-package-index.json",
    "test:whole-layer-owner-claims-composer": "node scripts/test-whole-layer-owner-claims-composer.mjs",
    "model:build-unowned-static-plan": "node scripts/build-unowned-static-partition-plan.mjs",
    "test:unowned-static-plan": "node scripts/test-unowned-static-partition-plan.mjs",
    "model:build-unowned-static-plan-v2": "node scripts/build-unowned-static-partition-plan-v2.mjs",
    "test:unowned-static-plan-v2": "node scripts/test-unowned-static-partition-plan-v2.mjs",
    "model:build-unowned-static-payloads": "node scripts/build-unowned-static-payload-candidate.mjs --force",
    "model:audit-unowned-static-payloads": "node scripts/audit-unowned-static-payload-candidate.mjs",
    "test:unowned-static-payload-contract": "node scripts/test-unowned-static-payload-contract.mjs",
    "test:whole-layer-ownership-plan-composer": "node scripts/test-whole-layer-ownership-plan-composer.mjs",
    "model:analyze-unowned-static-residency": "node scripts/analyze-unowned-static-residency.mjs",
    "test:spatial-resident-window": "node scripts/test-spatial-resident-window.mjs"
  },
  "dependencies": {
    "three": "0.181.2",
    "three-mesh-bvh": "^0.9.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.4.2",
    "@gltf-transform/extensions": "4.4.2",
    "@gltf-transform/functions": "4.4.2",
    "@types/three": "0.181.0",
    "ktx2-encoder": "0.6.0",
    "meshoptimizer": "1.2.0",
    "sharp": "0.35.3",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
